{
	"name": "natsume-simple",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",
	"features": {
		"ghcr.io/devcontainers/features/nix:1": {
			"multiUser": true,
			"version": "latest",
			"extraNixConfig": "experimental-features = nix-command flakes,keep-outputs = true,keep-derivations = true"
		},
		"ghcr.io/christophermacgown/devcontainer-features/direnv:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"mkhl.direnv",
				"ms-python.python",
				"svelte.svelte-vscode",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"bradlc.vscode-tailwindcss",
				"eamodio.gitlens",
				"editorconfig.editorconfig",
				"antfu.iconify",
				"hyoban.tailwindcss-classname-highlight",
				"jnoortheen.nix-ide",
				"ms-toolsai.jupyter"
			],
			"settings": {}
		}
	},
	"updateContentCommand": "nix flake show --no-write-lock-file",
	"postStartCommand": "direnv allow"
}
